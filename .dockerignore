# Git
.git
.gitignore

# Secrets / environment
.env
.env.*
!.env.example

# Python virtual environment
.venv
venv

# Python cache
__pycache__
*.py[cod]
*$py.class

# Pytest / coverage cache
.pytest_cache
.coverage
htmlcov

# IDE / editor
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Local logs
*.log